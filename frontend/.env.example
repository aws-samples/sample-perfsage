# PerfSage Frontend Configuration

# API Gateway Base URL (from CDK output — includes /v1 stage)
NEXT_PUBLIC_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/v1

# AWS Region
NEXT_PUBLIC_AWS_REGION=us-east-1

# AWS Credentials (for SigV4 signing API Gateway requests)
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=your-access-key-id
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=your-secret-access-key
NEXT_PUBLIC_AWS_SESSION_TOKEN=your-session-token
