# PerfSage Executor Agent Container
# Runs the Strands-based agent for orchestrating k6 tests

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy project files from executor_agent
COPY executor_agent/pyproject.toml executor_agent/requirements.txt ./
COPY executor_agent/src/ src/

# Install Python dependencies
RUN pip install --no-cache-dir -e .

# Create non-root user
RUN useradd -m -s /bin/bash perfsage
USER perfsage

# Environment
ENV PYTHONUNBUFFERED=1
ENV PERFSAGE_LOG_LEVEL=INFO

# Expose port for local WebSocket server (dev mode)
EXPOSE 8765

# Health check (satisfies CKV_DOCKER_2; batch/agent container so kept trivial)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD echo "healthy" || exit 1

ENTRYPOINT ["perfsage-executor"]
CMD ["--help"]
